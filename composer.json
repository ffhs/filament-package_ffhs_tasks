{
    "version": "0.1.0",
    "name": "ffhs/filament-package_ffhs_tasks",
    "description": "",
    "keywords": [
        "ffhs",
        "laravel",
        "filamentphp",
        "filament-package_ffhs_tasks",
        "tasks"
    ],
    "homepage": "https://github.com/ffhs/filament-package_ffhs_tasks",
    "support": {
        "issues": "https://github.com/ffhs/filament-package_ffhs_tasks/issues",
        "source": "https://github.com/ffhs/filament-package_ffhs_tasks"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Luc Kromer",
            "email": "luc.kromer@ffhs.ch",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ffhs\\FfhsTasks\\": "src/",
            "Ffhs\\FfhsTasks\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ffhs\\FfhsTasks\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ffhs\\FfhsTasks\\FfhsTasksServiceProvider"
            ],
            "aliases": {
                "FfhsTasks": "Ffhs\\FfhsTasks\\Facades\\FfhsTasks"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
